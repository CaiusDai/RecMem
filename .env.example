# Copy this file to `.env` and fill in the values below.
#     cp .env.example .env
# `.env` is gitignored and will never be committed.

# ============ Required ============
OPENAI_API_KEY=your-api-key-here

# ============ Optional: custom OpenAI-compatible endpoint ============
# Use a relay / proxy / self-hosted OpenAI-compatible server.
# Either name works; OPENAI_API_BASE takes precedence over OPENAI_BASE_URL
# when both are set.
# OPENAI_BASE_URL=https://your-relay.example.com/v1
# OPENAI_API_BASE=https://your-relay.example.com/v1

# ============ LoCoMo Benchmark Paths ============
LOCOMO_PATH=/path/to/dataset/Locomo/xxx.json
LOCOMO_SCORE_PATH=/path/to/RecMem/results/Locomo/scores/

# ============ LongMemEval-S Benchmark Paths ============
LONGMEMEVAL_S_PATH=/path/to/dataset/LongMemEval/xxx.json
LONGMEMEVAL_S_SCORE_PATH=/path/to/RecMem/results/LongMemEval/scores/

# ============ Optional: per-layer Qdrant storage paths ============
# These are fallbacks for the --semantic_store / --subconscious_store /
# --episodic_store CLI flags. Set them here if you'd rather not pass them
# on the command line every time. The values in the example run commands
# in Readme.md use the CLI flags, so leaving these unset is fine.
# SEMANTIC_STORE=/path/to/RecMem/results/qdrant/semantic
# SUBCONSCIOUS_STORE=/path/to/RecMem/results/qdrant/subconscious
# EPISODIC_STORE=/path/to/RecMem/results/qdrant/episodic
